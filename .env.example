NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoflow
DATABASE_SCHEMA=saas
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key
PUBLIC_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
WHATSAPP_SESSION_PATH=.data/whatsapp-sessions
WHATSAPP_HEADLESS=true
LOG_LEVEL=info
