# Copie este arquivo para .env.motor.local e preencha sem aspas.
# O motor local e a API da Vercel devem compartilhar o mesmo Neon e Redis.
NODE_ENV=production
DATABASE_URL=postgresql://usuario:senha@host-neon/banco?sslmode=require
DATABASE_SCHEMA=saas
DATABASE_POOL_MAX=5
REDIS_URL=rediss://usuario:senha@host-redis:porta
ACCESS_TOKEN_SECRET=mesmo-segredo-configurado-na-vercel-com-32-ou-mais-caracteres
REFRESH_TOKEN_SECRET=mesmo-segredo-configurado-na-vercel-com-32-ou-mais-caracteres
ENCRYPTION_KEY=mesma-chave-configurada-na-vercel-com-32-ou-mais-caracteres
PUBLIC_APP_URL=https://vercel-panel-delta.vercel.app
CORS_ORIGINS=https://vercel-panel-delta.vercel.app
WHATSAPP_SESSION_PATH=.data/whatsapp-sessions
WHATSAPP_HEADLESS=true
LOG_LEVEL=info
